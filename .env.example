SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI on the Spotify app exactly. Locally: http://127.0.0.1:8888/callback
SPOTIFY_REDIRECT_URI=
# Optional. Without these, rooms live in memory only.
SUPABASE_URL=
SUPABASE_KEY=
# Plain secret whose sha256 is in private.server_key
SUPABASE_ROOM_SECRET=
# Optional. Turns on "Spice up the wording" in the lobby.
ANTHROPIC_API_KEY=
